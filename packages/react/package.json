{
  "name": "@vizora/react",
  "version": "0.1.0",
  "description": "Vizora React adapter — <Chart>, <AutoChart>, and all chart UI components",
  "license": "MIT",
  "author": "Vizora Contributors",
  "homepage": "https://github.com/your-org/vizora#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vizora.git",
    "directory": "packages/react"
  },
  "keywords": ["chart", "react", "visualization", "svg", "dashboard"],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@vizora/core": "^0.1.0",
    "@vizora/render-svg": "^0.1.0",
    "@vizora/intelligence": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
