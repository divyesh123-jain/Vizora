{
  "name": "@vizora/core",
  "version": "0.1.0",
  "description": "Vizora core — ChartSpec schema, scales, transforms, and headless scene graph engine",
  "license": "MIT",
  "author": "Vizora Contributors",
  "homepage": "https://github.com/your-org/vizora#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vizora.git",
    "directory": "packages/core"
  },
  "keywords": ["chart", "visualization", "chartspec", "data", "svg"],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
