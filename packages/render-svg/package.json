{
  "name": "@vizora/render-svg",
  "version": "0.1.1",
  "description": "Vizora SVG renderer — converts a ChartSpec scene graph to an SVG string",
  "license": "MIT",
  "author": "Vizora Contributors",
  "homepage": "https://github.com/your-org/vizora#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vizora.git",
    "directory": "packages/render-svg"
  },
  "keywords": ["chart", "svg", "visualization", "renderer"],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@vizora/core": "^0.1.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
